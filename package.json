{
  "name": "prisim-client-audit",
  "private": true,
  "description": "PRISIM Client Audit Portal",
  "scripts": {
    "db:start": "node scripts/supabase-local.mjs start",
    "db:stop": "node scripts/supabase-local.mjs stop",
    "db:status": "node scripts/supabase-local.mjs status",
    "db:reset": "node scripts/supabase-local.mjs reset",
    "db:local:verify": "node scripts/supabase-local.mjs verify",
    "db:test": "node scripts/check-secrets.mjs && node scripts/supabase-local.mjs test && node scripts/auth-api.test.mjs && node scripts/mfa-enroll.test.mjs",
    "db:test:sql": "node scripts/supabase-local.mjs test",
    "db:test:auth": "node scripts/auth-api.test.mjs",
    "test:mfa": "node scripts/mfa-enroll.test.mjs",
    "db:lint": "node scripts/supabase-local.mjs lint",
    "functions:serve": "node scripts/supabase-local.mjs functions-serve",
    "functions:check": "node scripts/supabase-local.mjs functions-check",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "devDependencies": {
    "supabase": "^3.0.0"
  }
}
