APP_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Edge Function secrets (names only). Set real values in the hosted project with
#   npx supabase secrets set --project-ref <ref> NAME=value
# Never commit values. SUPABASE_URL, SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY are provided by the platform automatically.
# -----------------------------------------------------------------------------

# Random string, at least 32 characters. Signs OAuth state and derives PKCE.
OAUTH_STATE_SECRET=

# Random string, at least 32 characters. Must equal the Vault secret
# `prisim_cron_secret` used by pg_cron to call sync-ad-data.
CRON_SECRET=

# Meta Marketing API (Meta app with Marketing API product; App Review for ads_read)
META_APP_ID=
META_APP_SECRET=
# Optional; defaults to v26.0
META_API_VERSION=

# Google Ads API (OAuth client of type "Web application" + approved developer token)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
# Optional; defaults to v24
GOOGLE_ADS_API_VERSION=
