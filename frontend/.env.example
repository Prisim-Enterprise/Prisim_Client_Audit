# =====================================================
# PRISIM Client Audit Portal - frontend environment
# =====================================================
# Copy to `frontend/.env.local` for local development (git-ignored).
# In production, set these in Cloudflare Pages -> Settings -> Variables.
#
# Every variable prefixed with VITE_ is bundled into the browser JavaScript
# and is therefore PUBLIC. Only put values here that are safe to publish.
#
# NEVER put any of the following in a frontend env file:
#   - Supabase service_role key or sb_secret_... key
#   - Database password / connection string
#   - Meta or Google OAuth client secrets, developer tokens
#   - Token encryption keys
# Those belong in Supabase Edge Function secrets (`supabase secrets set`).
# =====================================================

# Supabase project URL.
#   Local:  http://127.0.0.1:54321           (printed by `supabase start`)
#   Hosted: https://<project-ref>.supabase.co (Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=http://127.0.0.1:54321

# Supabase public client key. Use the publishable key (sb_publishable_...)
# or, on older projects, the legacy "anon" JWT key. Both are public by design;
# data access is enforced by Row Level Security, not by hiding this key.
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-or-anon-key

# Public URL of this frontend. Used to build auth redirect URLs
# (invite acceptance, password reset, OAuth return). Must be listed in
# Supabase Auth -> URL Configuration -> Redirect URLs.
#   Local:  http://localhost:5173
#   Hosted: https://<your-project>.pages.dev or your custom domain
VITE_APP_URL=http://localhost:5173

# Deployment environment label shown in the UI and logs: local | preview | production
VITE_APP_ENV=local
